# Base URL of the SmartFace REST API. Only public, non-secret values belong in VITE_* variables.
#
# Recommended for development and production: same-origin path. In development the Vite dev
# server proxies /api to Django (http://127.0.0.1:8000), so session and CSRF cookies just work.
VITE_API_BASE_URL=/api/v1
#
# Direct mode (no proxy). Works only if the page is opened on the same host name as the API,
# e.g. http://127.0.0.1:5173 with the API on http://127.0.0.1:8000, and that origin is listed in
# CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS in backend/.env:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Where the dev proxy forwards /api (development only; not exposed to the browser bundle).
# DEV_API_PROXY_TARGET=http://127.0.0.1:8000
