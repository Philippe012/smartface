# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (existing SmartFace database) ----------------------------------
DB_NAME=SmartFace
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_YOUR_REAL_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Frontend / CORS -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
TIME_ZONE=Africa/Kigali
# Base URL used in password-reset emails.
FRONTEND_URL=http://localhost:5173

# --- Biometric & credential encryption (REQUIRED for enrollment and camera passwords)
# Generate with: python manage.py generate_encryption_key
# Back this key up separately from database backups. Losing it means re-enrolling everyone.
SMARTFACE_ENCRYPTION_KEY=replace-with-generated-fernet-key

# --- Optional -------------------------------------------------------------------
# FACE_MODELS_DIR=C:\SmartFace\models
# BACKUP_DIR=D:\SmartFaceBackups
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# SECURE_COOKIES=True          # defaults to True when DJANGO_DEBUG=False
# SECURE_SSL_REDIRECT=True     # set False only if TLS is terminated elsewhere and USE_X_FORWARDED_PROTO=True
# USE_X_FORWARDED_PROTO=False
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# Email for password recovery (console backend prints emails to the server log by default)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.local
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=SmartFace <no-reply@example.local>
